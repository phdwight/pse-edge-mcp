# Copy to .env for docker compose. NEVER commit .env.
POSTGRES_PASSWORD=change-me
# DATABASE_URL is set automatically inside compose; for bare-metal runs:
# DATABASE_URL=postgresql+asyncpg://pse:change-me@localhost:5432/pse_edge

# Market session overrides (defaults shown)
# PSE_MARKET_OPEN=09:30
# PSE_MARKET_CLOSE=15:00
# PSE_THROTTLE_RPS=1.0

# Auth — opt-in, requires DATABASE_URL. Users self-serve via OAuth 2.1 + passkeys; the CLI
# is for clients that do not speak OAuth, and is the only route on a plain-http deployment.
# Provision accounts with: pse-edge-admin create-user EMAIL && pse-edge-admin issue-token EMAIL
# PSE_AUTH_REQUIRED=1
# PSE_TOKEN_CACHE_TTL=60      # seconds; this is the revocation-latency budget, nothing else
# PSE_QUOTA_PER_MIN=60
# PSE_QUOTA_PER_DAY=2000

# DB connection pool (auth adds a potential lookup per request; tune under load)
# PSE_DB_POOL_SIZE=5
# PSE_DB_MAX_OVERFLOW=10

# Email (signup verification). The ZeptoMail key arrives at runtime only, never committed.
# ZEPTOMAIL_API_KEY=
#
# PSE_EMAIL_FROM must be an address on a domain ZeptoMail has VERIFIED, and it is the most
# common thing to get wrong. ZeptoMail verifies EXACT domains: a verified example.com does
# NOT cover mcp.example.com. Both compose files default this to no-reply@$PSE_DOMAIN, which
# is therefore wrong whenever your hostname is a subdomain. An unverified sender is refused
# with a bare HTTP 500 and an empty body, so signup fails in a way that looks like the
# server is broken rather than misconfigured. Test it before trusting it:
#   curl -sS -X POST https://api.zeptomail.com/v1.1/email \
#     -H "Authorization: Zoho-enczapikey $ZEPTOMAIL_API_KEY" \
#     -H 'Content-Type: application/json' \
#     -d '{"from":{"address":"noreply@example.com"},
#          "to":[{"email_address":{"address":"you@example.com"}}],
#          "subject":"test","htmlbody":"<p>test</p>"}'
# PSE_EMAIL_FROM=noreply@example.com
#
# Where the nightly schema canary reports failures. It emails ONLY on failure — a nightly
# "all fine" message is filtered within a week, and a filtered alert feels like coverage
# while providing none. Unset, the canary still runs and still logs, but nobody is told.
# PSE_OPERATOR_EMAIL=ops@example.com
#
# Accounts allowed to provision machine clients (headless/agent credentials) from the
# /account web page — the way to grant agent access on a NAS with no shell. Comma-separated,
# matched against the signed-in account's email. This is the SAME authority as the
# pse-edge-admin CLI: keep it to yourself. Empty = web provisioning off, CLI only.
# PSE_ADMIN_EMAILS=you@example.com
#
# PSE_PUBLIC_URL=https://mcp.example.com   # drives WebAuthn rp_id, email links, OAuth issuer
# PSE_USAGE_RETENTION_DAYS=90              # the privacy page states 90 — changing this
#                                          # changes what users were told

# --- VPS or host reachable on 80/443 (compose.yaml + compose.prod.yaml) — docs/deploy.md ---
# Caddy publishes high by default (8280/8243) to stay clear of a NAS's own web UI. Only the
# published side moves — Caddy still listens on 80/443 inside the container. YOUR ROUTER MUST
# FORWARD 80 -> 8280 AND 443 -> 8243, because certificate authorities always validate on 80
# (HTTP-01) or 443 (TLS-ALPN-01) and no setting changes that. If you cannot forward, use the
# NAS + tunnel path below, which needs no inbound ports at all.
# PSE_HTTP_PORT=8280
# PSE_HTTPS_PORT=8243
# PSE_DOMAIN must be the real public hostname: it becomes PSE_PUBLIC_URL, which drives the
# WebAuthn rp_id, the email links and the OAuth issuer. Wrong value = passkeys silently
# break, because credentials are bound to the origin they were enrolled under.
# PSE_DOMAIN=mcp.example.com
# PSE_ACME_EMAIL=ops@example.com
# PSE_IMAGE_TAG=0.11.0                 # PIN THIS — production pulls, it does not build.
# BACKUP_RETENTION_DAYS=14
# PSE_LOG_JSON=1
# PSE_LOG_LEVEL=INFO

# --- NAS stage 1: LAN only (compose.nas.yaml) — see docs/deploy.md ---
# Needs nothing from Cloudflare. Reachable at http://<nas-ip>:8200; auth is on, and passkeys
# cannot work over plain http, so mint a token with `pse-edge-admin issue-token`.
# PSE_IMAGE_TAG=0.11.0                 # PIN THIS. :latest may predate a flag this file uses.
# PSE_LAN_PORT=8200                   # host side only; the app always listens on 8000 inside
# PSE_WORKERS=1                       # each worker multiplies the in-memory quota ceiling
# APP_MEMORY_LIMIT=768m
# DB_MEMORY_LIMIT=1g
#
# Put the database and its dumps on NAS directories you can see and snapshot. Create both
# first — Docker will not, and the mount error does not name the missing path. Keep backups
# OUTSIDE the database directory: a backup stored inside the thing it protects is not one.
#
# No chown needed. Postgres runs as uid 999 and a bind mount would otherwise arrive
# root-owned, crash-looping on "mkdir: cannot create directory '/var/lib/postgresql':
# Permission denied" — so a `pgdata-owner` container fixes the ownership before the
# database starts. That matters on a NAS UI, which may give you no shell at all.
#
# PGDATA must be the NAS's OWN internal volume, never SMB/NFS/USB: Postgres needs POSIX
# locking and honest fsync. Dumps are just files, so a network share is fine for backups.
# SETTING PSE_PGDATA_PATH ON AN EXISTING DEPLOYMENT STARTS AN EMPTY DATABASE — dump first,
# see docs/deploy.md "Moving the database onto a NAS share".
# PSE_PGDATA_PATH=/volume1/docker/pse-mcp/pgdata
# PSE_BACKUP_PATH=/volume1/docker/pse-mcp/backups

# --- NAS stage 2: public hostname (+ compose.tunnel.yaml) — see docs/deploy.md ---
# cloudflared dials out; Cloudflare terminates TLS, so no ACME here. Set PSE_LAN_BIND to
# close the stage 1 LAN port — an overlay cannot remove a port, because Compose merges
# `ports` additively, so binding it to loopback is how it stops being reachable.
# PSE_LAN_BIND=127.0.0.1
# PSE_DOMAIN=mcp.example.com
# Set PSE_EMAIL_FROM in the Email section above — signup goes live at this stage, and the
# default derived from PSE_DOMAIN is wrong if this hostname is a subdomain.
# CLOUDFLARE_TUNNEL_TOKEN=            # Zero Trust -> Networks -> Tunnels
